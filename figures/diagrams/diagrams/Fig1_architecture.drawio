<mxfile host="aegis-grid make_diagrams.py"><diagram name="Fig1_architecture"><mxGraphModel dx="700" dy="330" grid="1" gridSize="10" pageWidth="700" pageHeight="330"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Control application&lt;br&gt;(EMS / AGC / SCADA master)&lt;br&gt;message M, deadline D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="200" height="40" as="geometry"/></mxCell><mxCell id="n3" value="L2  package-transform AONT&lt;br&gt;Y = AONT(M); RS(k,n) -&gt; n shards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="n4" value="L1/L5  AGP/1 record layer&lt;br&gt;AES-256-GCM; epoch, seq,&lt;br&gt;t_gen and deadline authenticated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="146" width="200" height="46" as="geometry"/></mxCell><mxCell id="n5" value="L3/L4  fixed-size records,&lt;br&gt;constant interval Δ, encrypted&lt;br&gt;dummies, EDF queue, late drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="200" height="46" as="geometry"/></mxCell><mxCell id="n6" value="L6  CAP + bounded policy: sets n&lt;br&gt;of L2 (k never lowered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="278" width="200" height="36" as="geometry"/></mxCell><mxCell id="n7" value="Untrusted IP network&lt;br&gt;(passive observer, active&lt;br&gt;attacker: drop/delay/replay/inject)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde4d9;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="212" width="160" height="46" as="geometry"/></mxCell><mxCell id="n8" value="L1  AGP/1 handshake&lt;br&gt;ML-KEM-768/1024 (± X25519)&lt;br&gt;ML-DSA-44/65/87 transcript sig.&lt;br&gt;X.509, pinned grid CA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f2ee;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="n9" value="L1/L5  open record: AEAD, session,&lt;br&gt;replay window, epoch,&lt;br&gt;deadline + clock skew" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e6;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="212" width="200" height="46" as="geometry"/></mxCell><mxCell id="n10" value="L2  RS decode from any k shards;&lt;br&gt;AONT inverse with canary;&lt;br&gt;exactly-once delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e6;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="146" width="200" height="46" as="geometry"/></mxCell><mxCell id="n11" value="L7  U = M̂ if valid before D,&lt;br&gt;else U_safe (hold last validated&lt;br&gt;set-point; droop active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e6;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="n12" value="Plant / actuator&lt;br&gt;(governor set-point, relay, RTU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e6;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="200" height="40" as="geometry"/></mxCell><mxCell id="n13" value="L6  observables: gaps, deadline&lt;br&gt;misses, rejected records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e6;strokeColor=#3a3a38;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="278" width="200" height="36" as="geometry"/></mxCell><mxCell id="e14" value="" style="endArrow=block;html=1;strokeColor=#3a3a38;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><